{
  "name": "@bundleup/sdk",
  "version": "0.4.0",
  "description": "Official JavaScript/TypeScript SDK for BundleUp",
  "homepage": "https://github.com/bundleup/bundleup-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/bundleup/bundleup-sdk-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bundleup/bundleup-sdk-js.git"
  },
  "license": "ISC",
  "author": "BundleUp",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^7.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.53.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
